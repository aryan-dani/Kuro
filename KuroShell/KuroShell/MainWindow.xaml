<Window
    x:Class="KuroShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kuro">
    <Grid x:Name="Root" Background="#F5F4EE" RequestedTheme="Light">
        <Grid.Resources>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontFamily" Value="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#141414" />
                <Setter Property="Margin" Value="0,2" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#141414" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontFamily" Value="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#141414" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Assets/Fonts/SpaceGrotesk-Bold.ttf#Space Grotesk" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#141414" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#52514E" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#141414" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MetaText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#52514E" />
                <Setter Property="CharacterSpacing" Value="24" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#141414" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="20,4,20,4" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style x:Key="Field" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F5F4EE" BorderBrush="#141414" BorderThickness="0,0,1,0" Padding="16,8,16,24">
                <StackPanel>
                    <TextBlock Text="Kuro" FontFamily="Assets/Fonts/SpaceGrotesk-Bold.ttf#Space Grotesk" FontSize="22" FontWeight="Normal" Foreground="#141414" Margin="14,8,0,28" />
                    <Button x:Name="NavConversation" Tag="Conversation" Style="{StaticResource NavButton}" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                            <TextBlock Text="Conversation" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavVoice" Tag="Voice" Style="{StaticResource NavButton}" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE720;" FontSize="16" />
                            <TextBlock Text="Voice" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDevices" Tag="Devices" Style="{StaticResource NavButton}" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE772;" FontSize="16" />
                            <TextBlock Text="Devices" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavContacts" Tag="Contacts" Style="{StaticResource NavButton}" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" />
                            <TextBlock Text="Contacts" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSystem" Tag="System" Style="{StaticResource NavButton}" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="System" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusLine" Style="{StaticResource MetaText}" Margin="40,8,40,0" Visibility="Collapsed" />
                <Grid Grid.Row="1" Padding="40,12,40,28">
                <Grid x:Name="ConversationPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Conversation" Style="{StaticResource PageTitle}" />
                        <Button Content="New conversation" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnNewConversation" />
                    </Grid>
                    <TextBlock x:Name="EmptyState" Grid.Row="1" Text="Hold Ctrl+Alt+Space." Style="{StaticResource BodyText}" Foreground="#52514E" Margin="0,28,0,0" />
                    <ScrollViewer x:Name="ThreadScroll" Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ThreadList" Spacing="12" />
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="VoicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Voice" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="How Kuro listens and speaks." Style="{StaticResource MetaText}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="VoiceRows" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="What this machine can reach." Style="{StaticResource MetaText}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="DeviceRows" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ContactsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Contacts" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Numbers stay masked." Style="{StaticResource MetaText}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="ContactList" />
                                <TextBox x:Name="ContactName" PlaceholderText="Name" Style="{StaticResource Field}" />
                                <TextBox x:Name="ContactNumber" PlaceholderText="Number" Style="{StaticResource Field}" />
                                <Button Content="Save contact" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,16,0,12" Click="OnSaveContact" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SystemPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Listening, logs, and the engine." Style="{StaticResource MetaText}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Padding="0,14">
                                    <StackPanel>
                                        <TextBlock Text="Pause listening" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="The hotkey stays quiet until you resume." Style="{StaticResource MetaText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PauseToggle" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnPauseToggled" />
                                </Grid>
                                <Border BorderBrush="#141414" BorderThickness="0,1,0,0" Padding="0,14">
                                    <StackPanel>
                                        <TextBlock Text="Logs" Style="{StaticResource SectionLabel}" />
                                        <TextBlock x:Name="LogPath" Style="{StaticResource MetaText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <Button Content="Open logs" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenLogs" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#141414" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <TextBlock Text="Router mode" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RouterModeText" Style="{StaticResource MetaText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#141414" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <TextBlock Text="Active voice" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TtsActiveText" Style="{StaticResource MetaText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#141414" BorderThickness="0,1,0,0" Padding="0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Restart engine" Style="{StaticResource QuietButton}" Click="OnRestart" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Workflows" Style="{StaticResource SectionLabel}" Margin="0,28,0,0" />
                        <Border Style="{StaticResource Card}">
                            <TextBlock x:Name="WorkflowNote" Style="{StaticResource BodyText}" Margin="0,12" />
                        </Border>
                        <TextBlock Text="Performance" Style="{StaticResource SectionLabel}" Margin="0,28,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="TimingRows" />
                        </Border>
                        <TextBlock Text="Capsule preview" Style="{StaticResource SectionLabel}" Margin="0,28,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="Playground" Margin="0,12,0,12" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Window>
