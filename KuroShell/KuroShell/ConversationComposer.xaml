<UserControl
    x:Class="KuroShell.ConversationComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Input"
                 PlaceholderText="Ask Kuro…"
                 FontFamily="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk"
                 FontSize="14"
                 CornerRadius="8"
                 Padding="12,10"
                 KeyDown="OnKeyDown" />
        <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="8,0,0,0"
                Background="#FFFFFF" BorderBrush="#E4E2D8" BorderThickness="1" CornerRadius="8"
                Padding="16,8"
                FontFamily="Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk"
                Foreground="#141414"
                Click="OnSend" />
    </Grid>
</UserControl>
