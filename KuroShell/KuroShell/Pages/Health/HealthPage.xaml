<UserControl
    x:Class="KuroShell.Pages.Health.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Padding="0,0,0,24">
            <Grid>
                <TextBlock Text="Health" FontFamily="ms-appx:///Assets/Fonts/SpaceGrotesk-Bold.ttf#Space Grotesk" FontSize="28" Foreground="#141414" />
                <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh"
                        Background="#FFFFFF" BorderBrush="#E4E2D8" BorderThickness="1" CornerRadius="8" Padding="14,8"
                        FontFamily="ms-appx:///Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk" Foreground="#141414" />
            </Grid>
            <TextBlock x:Name="StatusNote" Margin="0,8,0,16"
                       FontFamily="ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono"
                       FontSize="12" Foreground="#52514E" Text="Checking engine…" />
            <Border Background="#FFFFFF" BorderBrush="#E4E2D8" BorderThickness="1" CornerRadius="8" Padding="20,8">
                <StackPanel x:Name="Rows" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
