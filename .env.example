# Copy to .env and fill in. Never commit .env.

KURO_LLM_MODE=fallback
OLLAMA_MODEL=llama3.2

# STT: auto|cuda|npu|cpu — auto picks CUDA on AC, OpenVINO NPU on battery
KURO_STT_BACKEND=auto
KURO_WHISPER_MODEL=small.en
KURO_WHISPER_BEAM=5

# TTS: auto = XTTS on AC / Piper on battery
KURO_TTS_ENGINE=auto
KURO_PIPER_MODEL=bench/models/piper/en_US-lessac-medium.onnx

TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=
TUYA_VERSION=3.5

# Cloud inbox (n8n Cloud webhook) — see docs/CLOUD_INBOX.md
N8N_INBOX_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Kuro hub on the home server (Tailscale). Token must match /srv/kuro/.env
KURO_HUB_URL=http://100.78.60.50:18200
KURO_HUB_TOKEN=

