# Copy to .env (gitignored). Never commit secrets.

KURO_LLM_MODE=fallback
OLLAMA_MODEL=gemma4:e4b

KURO_STT_BACKEND=cuda
KURO_WHISPER_MODEL=large-v3-turbo-q5_0
KURO_WHISPER_BEAM=5

KURO_TTS_ENGINE=auto
KURO_PIPER_MODEL=

TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=
TUYA_VERSION=3.5

# Optional cloud inbox webhook
N8N_INBOX_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional self-hosted n8n (no default host; set your own)
KURO_N8N_BASE_URL=
KURO_N8N_TOKEN=

# Optional remote hub (requires both URL and token)
KURO_HUB_URL=
KURO_HUB_TOKEN=

# API
KURO_API=on
KURO_API_PORT=8765
KURO_SAY_EXECUTE=0

# Optional ritual sound path (profile-local)
DADDY_HOME_SONG_PATH=
